# Optional environment overrides. Copy to .env for development.
# Never commit real credentials.

# ENVMON_CONFIG=config/config.yaml
# ENVMON_STATION_NAME=Office
# ENVMON_TIMEZONE=Europe/Madrid
# ENVMON_LOG_LEVEL=INFO

# ENVMON_SENSORS__MODE=simulator
# ENVMON_SAMPLING__INTERVAL_SECONDS=30

# ENVMON_DATABASE__URL=sqlite:///data/envmon.db
# ENVMON_DATABASE__URL=postgresql+psycopg://envmon:secret@db.local:5432/envmon

# ENVMON_WEB__HOST=0.0.0.0
# ENVMON_WEB__PORT=8080

# External Ollama only; keep disabled unless it is reachable.
# ENVMON_LLM__ENABLED=true
# ENVMON_LLM__BASE_URL=http://192.168.1.10:11434
# ENVMON_LLM__MODEL=llama3.1:8b
